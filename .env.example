# Groq API key; leave empty to disable live model calls.
GROQ_API_KEY=
# Groq vision model identifier.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Model request timeout in seconds.
GROQ_TIMEOUT_SECONDS=30
# Maximum image upload size in bytes.
FOOD_IMAGE_MAX_BYTES=10485760
# Maximum processed image side length in pixels.
FOOD_IMAGE_MAX_SIDE=2048
# Maximum video upload size in bytes.
HYGIENE_VIDEO_MAX_BYTES=52428800
# Maximum video duration in seconds.
HYGIENE_VIDEO_MAX_SECONDS=120
# Maximum number of selected video frames.
HYGIENE_MAX_FRAMES=12
# Maximum simultaneous hygiene frame model requests.
HYGIENE_MAX_CONCURRENCY=1
# Delay between selected video frames in seconds.
HYGIENE_FRAME_DELAY_SECONDS=2
# Maximum processed hygiene frame side length in pixels.
HYGIENE_FRAME_MAX_SIDE=768
# In-memory profile lifetime in minutes.
PROFILE_TTL_MINUTES=60
# Optional USDA FoodData Central key; leave empty to use local reference data.
USDA_FDC_API_KEY=
# Use schema-validated sample responses instead of live model analysis.
DEMO_MODE=false
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional frontend API origin; empty uses the Vite /api development proxy.
VITE_API_BASE_URL=
